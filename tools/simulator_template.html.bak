// INSTALLED ROMS ATTRACT TOUR DEMO ENGINE
// -------------------------------------------------------------------------
const tourState = {
  active: false,
  gameIdx: 0,
  frameInGame: 0,
  framesPerGame: 540, // 9 seconds per game @ 60 FPS
  games: [
    { id: 'pacman', title: 'PAC-MAN', year: '1980 NAMCO', cpu: 'Z80 @ 3.072 MHz', sound: 'Namco WSG (3-ch Wavetable)', badge: 'MAZE CHASE' },
    { id: 'cclimber', title: 'CRAZY CLIMBER', year: '1980 NICHIBUTSU', cpu: 'Z80 @ 3.072 MHz', sound: 'AY-3-8910 PSG (Twin-Stick)', badge: 'VERTICAL CLIMB' },
    { id: 'galaga', title: 'GALAGA', year: '1981 NAMCO', cpu: '3× Z80 Cores', sound: 'Namco WSG 3-Voice Soundchip', badge: 'SPACE SHOOTER' },
    { id: 'dkong', title: 'DONKEY KONG', year: '1981 NINTENDO', cpu: 'Z80 + I8035 Co-processor', sound: 'Discrete DAC & Jump FX', badge: 'PLATFORM ICON' },
    { id: 'frogger', title: 'FROGGER', year: '1981 KONAMI', cpu: '2× Z80 Processors', sound: 'AY-3-8910 Chiptune Jingles', badge: 'TRAFFIC & RIVER' },
    { id: 'asteroids', title: 'ASTEROIDS', year: '1979 ATARI', cpu: 'MOS 6502 @ 1.5 MHz', sound: 'Discrete Analog Thruster / Saucer', badge: 'VECTOR GLOW' },
    { id: 'tempest', title: 'TEMPEST', year: '1981 ATARI', cpu: 'MOS 6502 + Math Box', sound: 'Dual Atari POKEY Soundchips', badge: 'ROTARY TUBE' },
    { id: 'gyruss', title: 'GYRUSS', year: '1983 KONAMI', cpu: '2× Z80 + 6809 Sound CPU', sound: '5× AY-3-8910 (15-Ch Orchestral)', badge: '360° COSMIC ODYSSEY' }
  ]
};

function toggleTourDemo() {
  initAudio();
  if (currentMode === 'tour') setMode('arcade'); else setMode('tour');
}

function nextTourGame() {
  initAudio();
  tourState.frameInGame = 0;
  tourState.gameIdx = (tourState.gameIdx + 1) % tourState.games.length;
  playArcadeSfx('WARP');
}

function prevTourGame() {
  initAudio();
  tourState.frameInGame = 0;
  tourState.gameIdx = (tourState.gameIdx - 1 + tourState.games.length) % tourState.games.length;
  playArcadeSfx('WARP');
}

function launchCurrentTourGame() {
  const g = tourState.games[tourState.gameIdx];
  tourState.active = false;
  if (g.id === 'cclimber') switchActiveGame('cclimber'); else switchActiveGame('pacman');
  setMode('arcade');
  ensurePastBoot();
  insertCoin();
  setTimeout(start1P, 200);
}

function renderGalagaTour(f) {
  ctx.fillStyle = '#05070e';
  ctx.fillRect(0, 0, 240, 240);

  // Starfield
  for (let i = 0; i < 28; i++) {
    const sx = (i * 37 + (i % 3) * 17) % 240;
    const sy = Math.floor((f * (i % 2 === 0 ? 3 : 1.5) + i * 29) % 240);
    ctx.fillStyle = i % 4 === 0 ? '#ff77aa' : (i % 3 === 0 ? '#00e5ff' : '#ffffff');
    ctx.fillRect(sx, sy, 2, 2);
  }

  // Boss Galaga & fleet formation
  const alienColors = ['#2ecc71', '#e74c3c', '#f1c40f'];
  for (let row = 0; row < 3; row++) {
    for (let col = 0; col < 6; col++) {
      const ax = 35 + col * 28 + Math.sin(f * 0.05 + row) * 8;
      const ay = 38 + row * 22;
      ctx.fillStyle = alienColors[row];
      ctx.fillRect(ax - 6, ay - 4, 12, 8);
      ctx.fillRect(ax - 4, ay - 6, 2, 2);
      ctx.fillRect(ax + 2, ay - 6, 2, 2);
    }
  }

  // Diving Boss Galaga in loop
  const diveX = 120 + Math.sin(f * 0.06) * 65;
  const diveY = 40 + (f * 2.8) % 155;
  ctx.fillStyle = '#3498db';
  ctx.fillRect(diveX - 8, diveY - 6, 16, 12);
  ctx.fillStyle = '#f1c40f';
  ctx.fillRect(diveX - 3, diveY - 9, 6, 3);

  // Tractor beam cone from diving boss
  if (f % 160 > 40 && f % 160 < 100) {
    ctx.fillStyle = 'rgba(0, 200, 255, 0.22)';
    ctx.beginPath();
    ctx.moveTo(diveX, diveY + 6);
    ctx.lineTo(diveX - 35, 230);
    ctx.lineTo(diveX + 35, 230);
    ctx.closePath();
    ctx.fill();
    if (f % 40 === 0) playArcadeSfx('TRACT');
  }

  // Player Dual Fighters at bottom
  const px = 120 + Math.sin(f * 0.035) * 50;
  const py = 202;
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(px - 10, py, 8, 14);
  ctx.fillStyle = '#e74c3c';
  ctx.fillRect(px - 12, py + 8, 12, 4);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(px + 2, py, 8, 14);
  ctx.fillStyle = '#e74c3c';
  ctx.fillRect(px, py + 8, 12, 4);

  // Dual Laser Blasts
  const laserY = py - (f * 9) % 170;
  ctx.fillStyle = '#00f0ff';
  ctx.fillRect(px - 6, laserY, 2, 8);
  ctx.fillRect(px + 6, laserY, 2, 8);

  if (f % 90 === 30) playArcadeSfx('DIVE');
}

function renderDonkeyKongTour(f) {
  ctx.fillStyle = '#09080a';
  ctx.fillRect(0, 0, 240, 240);

  // Slanted Steel Girders (Pink/Red steel)
  ctx.fillStyle = '#e84393';
  const girders = [
    { x1: 15, y1: 72, x2: 225, y2: 78 },
    { x1: 15, y1: 124, x2: 225, y2: 118 },
    { x1: 15, y1: 168, x2: 225, y2: 174 },
    { x1: 15, y1: 218, x2: 225, y2: 214 }
  ];
  girders.forEach(g => {
    ctx.fillRect(g.x1, g.y1, g.x2 - g.x1, 6);
    for (let x = g.x1 + 6; x < g.x2; x += 14) {
      ctx.fillRect(x, g.y1 - 2, 2, 10);
    }
  });

  // Blue Climbing Ladders
  ctx.fillStyle = '#0984e3';
  const ladders = [
    { x: 195, y: 74, h: 46 },
    { x: 45, y: 120, h: 50 },
    { x: 180, y: 170, h: 46 }
  ];
  ladders.forEach(l => {
    ctx.fillRect(l.x, l.y, 2, l.h);
    ctx.fillRect(l.x + 10, l.y, 2, l.h);
    for (let r = l.y + 4; r < l.y + l.h; r += 7) {
      ctx.fillRect(l.x, r, 12, 2);
    }
  });

  // Donkey Kong at top-left
  ctx.fillStyle = '#6c5ce7';
  ctx.fillRect(36, 44, 28, 26);
  ctx.fillStyle = '#d63031';
  ctx.fillRect(34, 46, 32, 22);
  const armUp = (f % 30 < 15);
  ctx.fillRect(28, armUp ? 38 : 50, 8, 14);
  ctx.fillRect(64, armUp ? 50 : 38, 8, 14);

  // Pauline at top
  ctx.fillStyle = '#fd79a8';
  ctx.fillRect(115, 48, 10, 20);
  ctx.fillStyle = '#ffeaa7';
  ctx.fillRect(117, 44, 6, 6);

  // Rolling Barrels
  const barrelX = 210 - (f * 1.8) % 180;
  ctx.fillStyle = '#e17055';
  ctx.beginPath();
  ctx.arc(barrelX, 210, 6, 0, Math.PI * 2);
  ctx.fill();

  // Jumpman / Mario running and jumping
  const mx = 35 + (f * 1.4) % 160;
  const isJumping = (Math.abs(mx - barrelX) < 28);
  const my = isJumping ? 194 : 206;
  ctx.fillStyle = '#d63031';
  ctx.fillRect(mx - 4, my - 12, 8, 12);
  ctx.fillStyle = '#0984e3';
  ctx.fillRect(mx - 3, my - 6, 6, 6);

  if (isJumping && f % 40 === 0) playArcadeSfx('DK-JUMP');
}

function renderFroggerTour(f) {
  ctx.fillStyle = '#0a0a14';
  ctx.fillRect(0, 0, 240, 240);

  // River section
  ctx.fillStyle = '#00204a';
  ctx.fillRect(0, 30, 240, 84);

  // Floating brown logs
  ctx.fillStyle = '#8d5524';
  for (let r = 0; r < 3; r++) {
    const spd = (r === 1 ? -1.2 : 1.5);
    const lx = (f * spd + r * 70) % 280 - 40;
    ctx.fillRect(lx, 38 + r * 26, 52, 16);
    ctx.fillStyle = '#5c3818';
    ctx.fillRect(lx + 4, 42 + r * 26, 44, 4);
    ctx.fillStyle = '#8d5524';
  }

  // Middle Sidewalk
  ctx.fillStyle = '#512b58';
  ctx.fillRect(0, 114, 240, 18);

  // Highway
  ctx.fillStyle = '#1b1b22';
  ctx.fillRect(0, 132, 240, 78);

  // Traffic
  const carColors = ['#f1c40f', '#e74c3c', '#00d2d3', '#ffffff'];
  for (let lane = 0; lane < 3; lane++) {
    const carSpd = (lane === 1 ? -2.2 : 1.8);
    const cx = (f * carSpd + lane * 90) % 280 - 40;
    ctx.fillStyle = carColors[lane];
    ctx.fillRect(cx, 138 + lane * 24, 28, 14);
    ctx.fillStyle = '#000';
    ctx.fillRect(cx + 3, 136 + lane * 24, 6, 2);
    ctx.fillRect(cx + 19, 136 + lane * 24, 6, 2);
  }

  // Frog hopping
  const hopStep = Math.floor(f / 35) % 6;
  const fy = 196 - hopStep * 28;
  const fx = 120 + Math.sin(f * 0.05) * 20;
  ctx.fillStyle = '#2ecc71';
  ctx.fillRect(fx - 5, fy - 5, 10, 10);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(fx - 4, fy - 7, 3, 3);
  ctx.fillRect(fx + 1, fy - 7, 3, 3);

  if (f % 70 === 0) playArcadeSfx('FROG-H');
}

function renderAsteroidsTour(f) {
  ctx.fillStyle = '#020306';
  ctx.fillRect(0, 0, 240, 240);

  ctx.save();
  ctx.strokeStyle = '#00f7ff';
  ctx.lineWidth = 1.5;
  ctx.shadowColor = '#00f7ff';
  ctx.shadowBlur = 8;

  const roids = [
    { x: 45, y: 65, r: 24, pts: 8, rot: f * 0.01 },
    { x: 195, y: 70, r: 28, pts: 9, rot: -f * 0.012 },
    { x: 60, y: 175, r: 20, pts: 7, rot: f * 0.015 },
    { x: 185, y: 170, r: 22, pts: 8, rot: -f * 0.008 }
  ];

  roids.forEach(r => {
    ctx.beginPath();
    for (let p = 0; p < r.pts; p++) {
      const a = (p / r.pts) * Math.PI * 2 + r.rot;
      const rad = r.r * (0.8 + ((p * 3) % 5) * 0.08);
      const px = r.x + Math.cos(a) * rad;
      const py = r.y + Math.sin(a) * rad;
      if (p === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.stroke();
  });

  // Center Player Ship
  const shipAngle = f * 0.04;
  ctx.strokeStyle = '#ffffff';
  ctx.beginPath();
  const tipX = 120 + Math.cos(shipAngle) * 12;
  const tipY = 120 + Math.sin(shipAngle) * 12;
  const lX = 120 + Math.cos(shipAngle + 2.5) * 10;
  const lY = 120 + Math.sin(shipAngle + 2.5) * 10;
  const rX = 120 + Math.cos(shipAngle - 2.5) * 10;
  const rY = 120 + Math.sin(shipAngle - 2.5) * 10;
  ctx.moveTo(tipX, tipY);
  ctx.lineTo(lX, lY);
  ctx.lineTo(120, 120);
  ctx.lineTo(rX, rY);
  ctx.closePath();
  ctx.stroke();

  // Thrust Flame
  if (f % 10 < 5) {
    ctx.strokeStyle = '#f39c12';
    ctx.beginPath();
    ctx.moveTo(lX, lY);
    ctx.lineTo(120 - Math.cos(shipAngle) * 8, 120 - Math.sin(shipAngle) * 8);
    ctx.lineTo(rX, rY);
    ctx.stroke();
  }

  // Vector Bullets
  const bx = 120 + Math.cos(shipAngle) * ((f * 6) % 90);
  const by = 120 + Math.sin(shipAngle) * ((f * 6) % 90);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(bx - 1, by - 1, 3, 3);

  ctx.restore();

  if (f % 140 === 0) playArcadeSfx('AST-THR');
  if (f % 260 === 180) playArcadeSfx('AST-EXP');
}

function renderTempestTour(f) {
  ctx.fillStyle = '#020308';
  ctx.fillRect(0, 0, 240, 240);

  ctx.save();
  ctx.strokeStyle = '#00a8ff';
  ctx.lineWidth = 1.5;
  ctx.shadowColor = '#00a8ff';
  ctx.shadowBlur = 9;

  const cx = 120, cy = 115;
  const spokes = 14;

  // 3D Perspective Web Rings
  [0.25, 0.55, 0.95].forEach(depth => {
    ctx.beginPath();
    for (let s = 0; s < spokes; s++) {
      const a = (s / spokes) * Math.PI * 2;
      const x = cx + Math.cos(a) * (90 * depth);
      const y = cy + Math.sin(a) * (65 * depth);
      if (s === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.stroke();
  });

  // Radial spoke lines
  for (let s = 0; s < spokes; s++) {
    const a = (s / spokes) * Math.PI * 2;
    ctx.beginPath();
    ctx.moveTo(cx + Math.cos(a) * 22, cy + Math.sin(a) * 16);
    ctx.lineTo(cx + Math.cos(a) * 90, cy + Math.sin(a) * 65);
    ctx.stroke();
  }

  // Player Yellow Claw on outer rim
  const clawSeg = Math.floor(f * 0.08) % spokes;
  const ca1 = (clawSeg / spokes) * Math.PI * 2;
  const ca2 = ((clawSeg + 1) / spokes) * Math.PI * 2;
  ctx.strokeStyle = '#f1c40f';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(cx + Math.cos(ca1) * 90, cy + Math.sin(ca1) * 65);
  ctx.lineTo(cx + Math.cos(ca2) * 90, cy + Math.sin(ca2) * 65);
  ctx.stroke();

  // Laser Particle Shot down channel
  const lDepth = 1.0 - (f * 0.05) % 0.8;
  const midA = (ca1 + ca2) / 2;
  ctx.fillStyle = '#ffff00';
  ctx.fillRect(cx + Math.cos(midA) * (90 * lDepth) - 2, cy + Math.sin(midA) * (65 * lDepth) - 2, 4, 4);

  // Superzapper lightning flash
  if (f % 160 === 80) {
    ctx.strokeStyle = '#ffffff';
    ctx.shadowColor = '#00ffff';
    ctx.lineWidth = 4;
    ctx.stroke();
    playArcadeSfx('TEM-ZAP');
  }

  ctx.restore();
}

function renderGyrussTour(f) {
  ctx.fillStyle = '#030208';
  ctx.fillRect(0, 0, 240, 240);

  const cx = 120, cy = 115;

  // Radiating Starfield Zooming Outward
  for (let i = 0; i < 35; i++) {
    const a = (i * 1.37) % (Math.PI * 2);
    const dist = (f * (2 + (i % 3)) + i * 18) % 120;
    const sx = cx + Math.cos(a) * dist;
    const sy = cy + Math.sin(a) * dist;
    ctx.fillStyle = dist > 90 ? '#ffffff' : (dist > 50 ? '#00e5ff' : '#7755ff');
    ctx.fillRect(sx, sy, dist > 70 ? 2 : 1, dist > 70 ? 2 : 1);
  }

  // Outer Orbit Circle
  ctx.save();
  ctx.strokeStyle = 'rgba(0, 229, 255, 0.4)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.arc(cx, cy, 78, 0, Math.PI * 2);
  ctx.stroke();

  // Player Ship Orbiting 360 degrees
  const pa = f * 0.045;
  const px = cx + Math.cos(pa) * 78;
  const py = cy + Math.sin(pa) * 78;
  ctx.fillStyle = '#f5a623';
  ctx.beginPath();
  ctx.arc(px, py, 5, 0, Math.PI * 2);
  ctx.fill();

  // Enemy Spiraling Formations
  for (let e = 0; e < 4; e++) {
    const ea = pa + Math.PI + e * 0.35;
    const ed = ((f * 2 + e * 25) % 85);
    const ex = cx + Math.cos(ea) * ed;
    const ey = cy + Math.sin(ea) * ed;
    ctx.fillStyle = '#e74c3c';
    ctx.fillRect(ex - 3, ey - 3, 6, 6);
  }
  ctx.restore();
}

function renderTourHud(game, f) {
  // 1. Top progress bar
  const pct = tourState.frameInGame / tourState.framesPerGame;
  ctx.fillStyle = '#f5a623';
  ctx.fillRect(0, 0, Math.floor(pct * 240), 3);

  // 2. Top-Left Badge: ATTRACT TOUR
  ctx.fillStyle = 'rgba(0, 0, 0, 0.72)';
  ctx.fillRect(6, 6, 126, 17);
  ctx.fillStyle = '#00ff66';
  ctx.font = 'bold 8px monospace';
  ctx.fillText(`ATTRACT TOUR [${tourState.gameIdx + 1}/${tourState.games.length}]`, 10, 18);

  // 3. Top-Right Timer
  const secsLeft = Math.ceil((tourState.framesPerGame - tourState.frameInGame) / 60);
  ctx.fillStyle = 'rgba(0, 0, 0, 0.72)';
  ctx.fillRect(194, 6, 40, 17);
  ctx.fillStyle = '#f5a623';
  ctx.font = 'bold 8px monospace';
  ctx.fillText(`${secsLeft}s ⏳`, 198, 18);

  // 4. Bottom Translucent Marquee Card
  ctx.fillStyle = 'rgba(8, 12, 16, 0.90)';
  ctx.fillRect(8, 176, 224, 58);
  ctx.strokeStyle = '#f5a623';
  ctx.lineWidth = 1;
  ctx.strokeRect(8, 176, 224, 58);

  // Title
  ctx.fillStyle = '#f5a623';
  ctx.font = 'bold 11px monospace';
  ctx.fillText(`${game.title} · ${game.year}`, 14, 191);

  // Hardware Spec
  ctx.fillStyle = '#00e5ff';
  ctx.font = '7.5px monospace';
  ctx.fillText(game.sound, 14, 203);

  ctx.fillStyle = '#aaa';
  ctx.font = '7.5px monospace';
  ctx.fillText(`${game.cpu} · ${game.badge}`, 14, 214);

  // Call to action prompt (blinking)
  if (Math.floor(f / 18) % 2 === 0) {
    ctx.fillStyle = '#00ff88';
    ctx.font = 'bold 8px monospace';
    ctx.fillText('▶ TAP / SPACE TO PLAY THIS GAME', 14, 226);
  }
}

function renderTourDemo() {
  tourState.frameInGame++;
  const f = tourState.frameInGame;
  const game = tourState.games[tourState.gameIdx];

  if (tourState.frameInGame >= tourState.framesPerGame) {
    nextTourGame();
    return;
  }

  switch (game.id) {
    case 'pacman':
      renderArcadeFrame();
      break;
    case 'cclimber':
      renderCrazyClimber();
      climberStep('left', (f % 40 < 20 ? 'up' : 'down'));
      climberStep('right', (f % 40 >= 20 ? 'up' : 'down'));
      break;
    case 'galaga':
      renderGalagaTour(f);
      break;
    case 'dkong':
      renderDonkeyKongTour(f);
      break;
    case 'frogger':
      renderFroggerTour(f);
      break;
    case 'asteroids':
      renderAsteroidsTour(f);
      break;
    case 'tempest':
      renderTempestTour(f);
      break;
    case 'gyruss':
      renderGyrussTour(f);
      break;
    default:
      renderArcadeFrame();
      break;
  }

  renderTourHud(game, f);
}

// -------------------------------------------------------------------------
// MODES & STATE MANAGEMENT
// -------------------------------------------------------------------------
const MODES = ['arcade', 'tour', 'demo', 'soundboard', 'tracker', 'rewind', 'vector', 'glitch'];
let currentMode = 'arcade';
const rewindBuffer = [];
let isRewinding = false;

// 27 Silicone Keys
const pianoContainer = document.getElementById('pianoKeys');
const noteNames = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

for (let i = 0; i < 27; i++) {
  const noteInOct = i % 12;
  const isBlack = [1, 3, 6, 8, 10].includes(noteInOct);
  if (!isBlack) {
    const btn = document.createElement('div');
    btn.className = 'key-white';
    btn.dataset.key = i;
    btn.innerHTML = `<span>${noteNames[noteInOct]}</span><div class="sfx-dot" style="background:${getSfxCategoryColor(i)};"></div>`;
    btn.onmousedown = () => onKeyTouch(i, true);
    btn.onmouseup = () => onKeyTouch(i, false);
    btn.onmouseleave = () => onKeyTouch(i, false);
    btn.ontouchstart = (e) => { e.preventDefault(); onKeyTouch(i, true); };
    btn.ontouchend = (e) => { e.preventDefault(); onKeyTouch(i, false); };
    pianoContainer.appendChild(btn);
  }
}

let currWhite = 0;
for (let i = 0; i < 27; i++) {
  const noteInOct = i % 12;
  const isBlack = [1, 3, 6, 8, 10].includes(noteInOct);
  if (isBlack) {
    const btn = document.createElement('div');
    btn.className = 'key-black';
    btn.dataset.key = i;
    btn.innerHTML = `<span>${noteNames[noteInOct]}</span><div class="sfx-dot" style="background:${getSfxCategoryColor(i)};"></div>`;
    btn.style.left = `calc(${currWhite * 6.25}% - 2.1%)`;
    btn.onmousedown = () => onKeyTouch(i, true);
    btn.onmouseup = () => onKeyTouch(i, false);
    btn.onmouseleave = () => onKeyTouch(i, false);
    btn.ontouchstart = (e) => { e.preventDefault(); onKeyTouch(i, true); };
    btn.ontouchend = (e) => { e.preventDefault(); onKeyTouch(i, false); };
    pianoContainer.appendChild(btn);
  } else {
    currWhite++;
  }
}

function updateKeyLabels() {
  document.querySelectorAll('.key-white, .key-black').forEach(el => {
    const k = parseInt(el.dataset.key);
    const noteInOct = k % 12;
    const catColor = getSfxCategoryColor(k);
    if (currentMode === 'soundboard') {
      el.innerHTML = `<span style="font-size:0.5rem;color:${catColor};font-weight:900;letter-spacing:0.3px;">${sfxNames[k]}</span><div class="sfx-dot" style="background:${catColor};box-shadow:0 0 6px ${catColor};"></div>`;
    } else {
      el.innerHTML = `<span>${noteNames[noteInOct]}</span><div class="sfx-dot" style="background:${catColor};"></div>`;
    }
  });
}

function onKeyTouch(keyIdx, isDown) {
  initAudio();
  const el = document.querySelector(`[data-key="${keyIdx}"]`);
  if (el) el.classList.toggle('active', isDown);

  const midiLed = document.getElementById('midiLed');
  if (midiLed) midiLed.classList.toggle('active', isDown);
  
  if (currentMode === 'soundboard' && isDown) {
    playArcadeSfx(sfxNames[keyIdx]);
    return;
  }
  
  // Live Multi-Engine Synthesizer across Tracker, Synth, Arcade, Vector
  playLiveSynthNote(keyIdx, isDown);
}

// Mode Selection
document.querySelectorAll('.mode-tag').forEach(tag => {
  tag.onclick = () => setMode(tag.dataset.mode);
});

function setMode(mode) {
  currentMode = mode;
  document.querySelectorAll('.mode-tag').forEach(t => t.classList.toggle('active', t.dataset.mode === mode));
  document.getElementById('jukeboxPanel').style.display = (mode === 'demo') ? 'flex' : 'none';
  const tourBtn = document.getElementById('btnGameTour');
  if (tourBtn) tourBtn.classList.toggle('active', mode === 'tour');
  updateKeyLabels();

  if (mode === 'tour') {
    tourState.active = true;
    tourState.frameInGame = 0;
    document.getElementById('engineStatus').innerHTML = 'ARCADE TOUR DEMO: <b>CYCLING ALL INSTALLED ROMS</b>';
    document.getElementById('hudStatus').textContent = '● TOUR DEMO ACTIVE';
  } else {
    tourState.active = false;
    if (mode !== 'tracker') {
      stopTracker();
    }
    if (mode === 'demo') {
      document.getElementById('engineStatus').textContent = 'DEMO SONGS JUKEBOX ACTIVE';
      playDemoSong();
    } else {
      pauseDemoSong();
      if (mode === 'arcade') {
        if (activeGame === 'cclimber') {
          document.getElementById('engineStatus').innerHTML = 'CRAZY CLIMBER: <b>1980 NICHIBUTSU Z80 + AY-3-8910</b> (Twin-Stick)';
          document.getElementById('hudStatus').textContent = '● CRAZY CLIMBER (TWIN-STICK)';
        } else {
          document.getElementById('engineStatus').textContent = 'PAC-MAN (60 FPS Z80 + WSG)';
          document.getElementById('hudStatus').textContent = '● PAC-MAN ACTIVE';
        }
      }
      else if (mode === 'soundboard') document.getElementById('engineStatus').textContent = '27-KEY AUTHENTIC ARCADE SFX SOUNDBOARD';
      else if (mode === 'tracker') {
        document.getElementById('engineStatus').innerHTML = `16-STEP CHIPTUNE TRACKER: <b>${trackerEngine.patterns[trackerEngine.currentPatternIdx].name}</b> (${trackerEngine.bpm} BPM)`;
        document.getElementById('hudStatus').textContent = '● TRACKER (16-STEP CHIPTUNE)';
        startTracker();
      }
      else if (mode === 'vector') document.getElementById('engineStatus').textContent = 'XY LISSAJOUS VECTOR OSCILLOSCOPE';
      else if (mode === 'glitch') document.getElementById('engineStatus').textContent = 'RAM CIRCUIT-BENDER ACTIVE';
    }
  }
}

// -------------------------------------------------------------------------
// BULLETPROOF PAC-MAN CONTROLS & QUICK PLAY
// -------------------------------------------------------------------------
let coinPulseFrames = 0;
let startPulseFrames = 0;

function ensurePastBoot() {
  let safety = 0;
  while (animTick < 305 && safety < 350) {
    stepCpuFrame();
    safety++;
  }
}

function insertCoin() {
  initAudio();
  ensurePastBoot();
  playArcadeSfx('COIN');
  coinPulseFrames = 12; // 6 frames down, 6 frames up
  keyCoin = true;
  setTimeout(() => { keyCoin = false; }, 200);
}

function start1P() {
  initAudio();
  ensurePastBoot();
  startPulseFrames = 12; // 6 frames down, 6 frames up
  keyStart = true;
  setTimeout(() => { keyStart = false; }, 200);
}

function quickPlay() {
  initAudio();
  setMode('arcade');
  ensurePastBoot();
  
  const credits = ram[0x4e69 - 0x4000];
  if (credits === 0) {
    playArcadeSfx('COIN');
    coinPulseFrames = 14;
    keyCoin = true;
    setTimeout(() => {
      keyCoin = false;
      setTimeout(() => {
        startPulseFrames = 14;
        keyStart = true;
        setTimeout(() => { keyStart = false; }, 180);
      }, 80);
    }, 120);
  } else {
    startPulseFrames = 14;
    keyStart = true;
    setTimeout(() => { keyStart = false; }, 180);
  }

  document.getElementById('hudStatus').className = 'hud-badge';
  document.getElementById('hudStatus').textContent = '● PLAYING: LIVE!';
}

document.getElementById('btnQuickPlay').onclick = () => { skipSplashScreen(); quickPlay(); };
document.getElementById('btnCoin').onclick = () => { skipSplashScreen(); insertCoin(); };
document.getElementById('btnStart').onclick = () => { skipSplashScreen(); start1P(); };

document.getElementById('btnRewind').onmousedown = () => { isRewinding = true; setMode('rewind'); };
document.getElementById('btnRewind').onmouseup = () => { isRewinding = false; setMode('arcade'); };

document.getElementById('btnGlitch').onclick = () => {
  initAudio();
  setMode('glitch');
  for (let g = 0; g < 32; g++) {
    const addr = Math.floor(Math.random() * 0x400);
    ram[addr] = (ram[addr] + 7) & 0xff;
  }
  for (let s = 0; s < 16; s++) {
    spritePos[s] = (spritePos[s] + 8) & 0xff;
  }
  setTimeout(() => setMode('arcade'), 1200);
};

// CRT Scanlines Toggle
function toggleScanlines() {
  crtScanlines = !crtScanlines;
  document.getElementById('crtStatus').textContent = crtScanlines ? 'SCANLINES: ON' : 'SCANLINES: OFF';
  document.getElementById('crtStatusText').textContent = crtScanlines ? 'ENABLED' : 'DISABLED';
}
document.getElementById('crtStatus').onclick = toggleScanlines;

var dpadActiveDir = (typeof dpadActiveDir !== 'undefined') ? dpadActiveDir : null;
var arcadeKeysDown = (typeof arcadeKeysDown !== 'undefined') ? arcadeKeysDown : {};

function handleUnifiedAction(act, isDown = true) {
  initAudio();
  if (typeof splashState !== 'undefined' && splashState.active) {
    if (isDown && typeof skipSplashScreen === 'function') skipSplashScreen();
    return;
  }
  if (currentMode === 'tour') {
    if (isDown) {
      if (act === 'right' && typeof nextTourGame === 'function') nextTourGame();
      else if (act === 'left' && typeof prevTourGame === 'function') prevTourGame();
      else if (typeof launchCurrentTourGame === 'function') launchCurrentTourGame();
    }
    return;
  }

  // 1. PAC-MAN
  if (activeGame === 'pacman') {
    if (act === 'up') {
      keyUp = isDown;
      if (isDown) { keyDown = false; keyLeft = false; keyRight = false; }
    } else if (act === 'down') {
      keyDown = isDown;
      if (isDown) { keyUp = false; keyLeft = false; keyRight = false; }
    } else if (act === 'left') {
      keyLeft = isDown;
      if (isDown) { keyUp = false; keyDown = false; keyRight = false; }
    } else if (act === 'right') {
      keyRight = isDown;
      if (isDown) { keyUp = false; keyDown = false; keyLeft = false; }
    } else if (act === 'action') {
      if (isDown && typeof quickPlay === 'function') quickPlay();
    }
    return;
  }

  // 2. CRAZY CLIMBER
  if (activeGame === 'cclimber') {
    if (isDown && typeof climberState !== 'undefined') {
      if (act === 'up') { climberStep('left', 'up'); climberStep('right', 'up'); }
      else if (act === 'down') { climberStep('left', 'down'); climberStep('right', 'down'); }
      else if (act === 'left') { climberState.col = Math.max(0, climberState.col - 1); }
      else if (act === 'right') { climberState.col = Math.min(3, climberState.col + 1); }
      else if (act === 'action') { climberStep(climberState.leftArm === 'up' ? 'right' : 'left', 'up'); }
    }
    return;
  }

  // 3. GALAGA
  if (activeGame === 'galaga') {
    if (typeof galagaGame !== 'undefined') {
      if (act === 'left') {
        galagaGame.moveDir = isDown ? -1 : (arcadeKeysDown['d'] || arcadeKeysDown['arrowright'] ? 1 : 0);
      } else if (act === 'right') {
        galagaGame.moveDir = isDown ? 1 : (arcadeKeysDown['a'] || arcadeKeysDown['arrowleft'] ? -1 : 0);
      } else if (act === 'up' || act === 'down' || act === 'action') {
        if (isDown && typeof galagaFire === 'function') galagaFire();
      }
    }
    return;
  }

  // 4. DONKEY KONG
  if (activeGame === 'dkong') {
    if (typeof dkongGame !== 'undefined') {
      const m = dkongGame.mario;
      if (act === 'left') {
        if (isDown) {
          m.vx = -1.8;
          m.facing = 'left';
          if (m.onGround) m.state = m.hasHammer ? 'hammer' : 'run';
        } else {
          if (m.vx < 0) {
            m.vx = (arcadeKeysDown['d'] || arcadeKeysDown['arrowright']) ? 1.8 : 0;
            if (m.vx === 0 && m.onGround) m.state = m.hasHammer ? 'hammer' : 'stand';
          }
        }
      } else if (act === 'right') {
        if (isDown) {
          m.vx = 1.8;
          m.facing = 'right';
          if (m.onGround) m.state = m.hasHammer ? 'hammer' : 'run';
        } else {
          if (m.vx > 0) {
            m.vx = (arcadeKeysDown['a'] || arcadeKeysDown['arrowleft']) ? -1.8 : 0;
            if (m.vx === 0 && m.onGround) m.state = m.hasHammer ? 'hammer' : 'stand';
          }
        }
      } else if (act === 'up') {
        if (isDown && typeof dkongClimbUp === 'function') dkongClimbUp();
      } else if (act === 'down') {
        if (isDown && typeof dkongClimbDown === 'function') dkongClimbDown();
      } else if (act === 'action') {
        if (isDown && typeof dkongJump === 'function') dkongJump();
      }
    }
    return;
  }

  // 5. FROGGER
  if (activeGame === 'frogger') {
    if (isDown && typeof froggerHop === 'function') {
      if (act === 'up') froggerHop('up');
      else if (act === 'down') froggerHop('down');
      else if (act === 'left') froggerHop('left');
      else if (act === 'right') froggerHop('right');
      else if (act === 'action') froggerHop('up');
    }
    return;
  }

  // 6. ASTEROIDS
  if (activeGame === 'asteroids') {
    if (typeof asteroidsGame !== 'undefined') {
      if (act === 'left') {
        if (isDown) asteroidsGame.ship.angle -= 0.20;
      } else if (act === 'right') {
        if (isDown) asteroidsGame.ship.angle += 0.20;
      } else if (act === 'up') {
        asteroidsGame.ship.thrust = isDown;
        if (isDown && typeof playArcadeSfx === 'function') playArcadeSfx('AST-THR');
      } else if (act === 'down') {
        if (isDown && typeof asteroidsHyperspace === 'function') asteroidsHyperspace();
      } else if (act === 'action') {
        if (isDown && typeof asteroidsFire === 'function') asteroidsFire();
      }
    }
    return;
  }

  // 7. TEMPEST
  if (activeGame === 'tempest') {
    if (isDown && typeof tempestGame !== 'undefined') {
      if (act === 'left') {
        tempestGame.segment = (tempestGame.segment - 1 + 16) % 16;
        if (typeof playArcadeSfx === 'function') playArcadeSfx('TEM-FLIP');
      } else if (act === 'right') {
        tempestGame.segment = (tempestGame.segment + 1) % 16;
        if (typeof playArcadeSfx === 'function') playArcadeSfx('TEM-FLIP');
      } else if (act === 'up') {
        if (typeof tempestSuperzapper === 'function') tempestSuperzapper();
      } else if (act === 'down' || act === 'action') {
        if (typeof tempestFire === 'function') tempestFire();
      }
    }
    return;
  }

  // 8. GYRUSS
  if (activeGame === 'gyruss') {
    if (typeof gyrussGame !== 'undefined') {
      if (act === 'left') {
        if (isDown) gyrussGame.angle -= 0.18;
      } else if (act === 'right') {
        if (isDown) gyrussGame.angle += 0.18;
      } else if (act === 'up' || act === 'down' || act === 'action') {
        if (isDown && typeof gyrussFire === 'function') gyrussFire();
      }
    }
    return;
  }
}

// Hardware & Virtual D-Pad Button Bindings
function bindDpad(btnId, dir) {
  const btn = document.getElementById(btnId);
  if (!btn) return;
  const start = (e) => {
    e.preventDefault();
    initAudio();
    dpadActiveDir = dir;
    handleUnifiedAction(dir, true);
    btn.classList.add('active');
  };
  const end = (e) => {
    e.preventDefault();
    if (dpadActiveDir === dir) dpadActiveDir = null;
    handleUnifiedAction(dir, false);
    btn.classList.remove('active');
  };
  btn.onmousedown = start; btn.onmouseup = end; btn.onmouseleave = end;
  btn.ontouchstart = start; btn.ontouchend = end;
}

bindDpad('dpadUp', 'up');
bindDpad('dpadDown', 'down');
bindDpad('dpadLeft', 'left');
bindDpad('dpadRight', 'right');

// Canvas Quadrant Tap / Click Steering
function handleCanvasSteer(clientX, clientY, isDown = true) {
  initAudio();
  if (typeof splashState !== 'undefined' && splashState.active) {
    if (isDown && typeof skipSplashScreen === 'function') skipSplashScreen();
    return;
  }
  if (currentMode === 'tour') {
    if (isDown && typeof launchCurrentTourGame === 'function') launchCurrentTourGame();
    return;
  }
  const rect = canvas.getBoundingClientRect();
  const x = (clientX - rect.left) / rect.width - 0.5;
  const y = (clientY - rect.top) / rect.height - 0.5;

  if (activeGame === 'cclimber') {
    if (isDown && typeof climberStep === 'function') {
      if (x < 0) climberStep('left', y < 0 ? 'up' : 'down');
      else climberStep('right', y < 0 ? 'up' : 'down');
    }
    return;
  }

  let act = 'up';
  if (Math.abs(x) > Math.abs(y)) {
    act = (x > 0) ? 'right' : 'left';
  } else {
    act = (y > 0) ? 'down' : 'up';
  }
  handleUnifiedAction(act, isDown);
}

canvas.onmousedown = (e) => handleCanvasSteer(e.clientX, e.clientY, true);
canvas.ontouchstart = (e) => {
  e.preventDefault();
  if (e.touches.length) handleCanvasSteer(e.touches[0].clientX, e.touches[0].clientY, true);
};
canvas.ontouchend = (e) => {
  e.preventDefault();
  handleUnifiedAction('left', false);
  handleUnifiedAction('right', false);
  handleUnifiedAction('up', false);
  handleUnifiedAction('down', false);
  handleUnifiedAction('action', false);
};
window.onmouseup = () => {
  if (dpadActiveDir) {
    handleUnifiedAction(dpadActiveDir, false);
    dpadActiveDir = null;
  }
  handleUnifiedAction('left', false);
  handleUnifiedAction('right', false);
  handleUnifiedAction('up', false);
  handleUnifiedAction('down', false);
  handleUnifiedAction('action', false);
};

// Interactive Precision Rotary Knobs with Radial Arc Gauge & Wheel Support
function setupKnob(id, min, max, initial, format, onChange) {
  const dial = document.getElementById(id);
  const arc = document.getElementById(id + '-arc');
  let val = initial;
  let startY = 0, startVal = 0;

  function updateVisual() {
    const pct = Math.max(0, Math.min(1, (val - min) / (max - min)));
    dial.style.transform = `rotate(${(pct * 270) - 135}deg)`;
    if (arc) {
      const circ = 125.66;
      arc.style.strokeDasharray = circ;
      arc.style.strokeDashoffset = circ - (pct * 94.25);
    }
    onChange(val);
  }

  dial.onmousedown = (e) => {
    initAudio();
    startY = e.clientY;
    startVal = val;
    window.onmousemove = (me) => {
      const dy = startY - me.clientY;
      const delta = (dy / 120) * (max - min);
      val = Math.max(min, Math.min(max, startVal + delta));
      updateVisual();
    };
    window.onmouseup = () => { window.onmousemove = null; window.onmouseup = null; };
  };

  // Mouse wheel support
  if (dial.addEventListener) {
    dial.addEventListener('wheel', (e) => {
      e.preventDefault();
      initAudio();
      const step = (max - min) / 32;
      const delta = e.deltaY < 0 ? step : -step;
      val = Math.max(min, Math.min(max, val + delta));
      updateVisual();
    }, { passive: false });

    // Touch screen support
    dial.addEventListener('touchstart', (e) => {
      initAudio();
      startY = e.touches[0].clientY;
      startVal = val;
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (!startY) return;
      const dy = startY - e.touches[0].clientY;
      const delta = (dy / 120) * (max - min);
      val = Math.max(min, Math.min(max, startVal + delta));
      updateVisual();
    }, { passive: true });
    window.addEventListener('touchend', () => { startY = 0; });
  }

  // Double click reset to initial value
  dial.ondblclick = () => {
    val = initial;
    updateVisual();
  };

  updateVisual();
}

setupKnob('knob1', 400, 12000, 6500, (v) => `${(v/1000).toFixed(1)} kHz`, (v) => {
  if (filterNode) filterNode.frequency.value = v;
  document.getElementById('valKnob1').textContent = `${(v/1000).toFixed(1)} kHz`;
});

setupKnob('knob2', 0.05, 0.8, 0.28, (v) => `${Math.round(v*1000)} ms`, (v) => {
  if (delayNode) delayNode.delayTime.value = v;
  document.getElementById('valKnob2').textContent = `${Math.round(v*1000)} ms`;
});

setupKnob('knob3', 0.0, 0.85, 0.0, (v) => `${Math.round(v*100)}%`, (v) => {
  if (feedbackNode) feedbackNode.gain.value = v;
  if (delaySendNode) delaySendNode.gain.value = v > 0.01 ? Math.min(0.75, v * 1.1) : 0.0;
  document.getElementById('valKnob3').textContent = `${Math.round(v*100)}%`;
});

setupKnob('knob4', 0, 7, 0, (v) => `WSG ${Math.round(v)}`, (v) => {
  const w = Math.round(v);
  wsgVoices[0].wave = w; wsgVoices[1].wave = w; wsgVoices[2].wave = w;
  document.getElementById('valKnob4').textContent = `WSG ${w}`;
});

// Demo Jukebox Buttons
document.getElementById('btnJukePlay').onclick = () => {
  if (demoPlayer.playing) pauseDemoSong(); else playDemoSong();
};
document.getElementById('btnJukeStop').onclick = stopDemoSong;


// Keyboard Listeners (Arrows, WASD, 1, 5, Space, Enter, R, B, K, Z, T)
window.addEventListener('keydown', (e) => {
  initAudio();
  if (typeof splashState !== 'undefined' && splashState.active) {
    if (typeof skipSplashScreen === 'function') skipSplashScreen();
    e.preventDefault();
    return;
  }
  const k = e.key.toLowerCase();
  arcadeKeysDown[k] = true;
  arcadeKeysDown[e.key] = true;

  // Illumination of on-screen controller deck
  const cL = document.getElementById('ctrlBtnLeft'); if (cL && (k === 'a' || e.key === 'ArrowLeft')) cL.classList.add('pressed');
  const cR = document.getElementById('ctrlBtnRight'); if (cR && (k === 'd' || e.key === 'ArrowRight')) cR.classList.add('pressed');
  const cU = document.getElementById('ctrlBtnUp'); if (cU && (k === 'w' || e.key === 'ArrowUp')) cU.classList.add('pressed');
  const cD = document.getElementById('ctrlBtnDown'); if (cD && (k === 's' || e.key === 'ArrowDown')) cD.classList.add('pressed');
  const cF = document.getElementById('ctrlBtnFire'); if (cF && (e.key === ' ' || e.key === 'Enter')) cF.classList.add('pressed');
  const cC = document.getElementById('ctrlBtnCoin'); if (cC && (k === '1' || k === 'c')) cC.classList.add('pressed');
  const cS = document.getElementById('ctrlBtnStart'); if (cS && (k === '5' || k === 'p')) cS.classList.add('pressed');
  const cG = document.getElementById('ctrlBtnImmortal'); if (cG && (k === 'i' || k === 'g')) cG.classList.add('pressed');
  const cLvl = document.getElementById('ctrlBtnLevelSkip'); if (cLvl && (k === 'l' || k === 'n')) cLvl.classList.add('pressed');

  if (k === 'i' || k === 'g') {
    if (typeof toggleImmortalMode === 'function') toggleImmortalMode();
    e.preventDefault();
    return;
  }
  if (k === 'l' || (currentMode !== 'tour' && k === 'n')) {
    if (typeof skipCurrentLevel === 'function') skipCurrentLevel();
    e.preventDefault();
    return;
  }

  if (k === 't') {
    if (typeof toggleTourDemo === 'function') toggleTourDemo();
    e.preventDefault();
    return;
  }

  if (currentMode === 'tour') {
    if (e.key === ' ' || e.key === 'Enter' || k === '1' || k === 'c' || k === '5' || k === 'p') {
      if (typeof launchCurrentTourGame === 'function') launchCurrentTourGame();
      e.preventDefault();
      return;
    }
    if (e.key === 'ArrowRight' || k === 'd' || k === 'n') {
      if (typeof nextTourGame === 'function') nextTourGame();
      e.preventDefault();
      return;
    }
    if (e.key === 'ArrowLeft' || k === 'a' || k === 'p') {
      if (typeof prevTourGame === 'function') prevTourGame();
      e.preventDefault();
      return;
    }
    return;
  }

  // Crazy Climber Twin-Stick specific shortcuts
  if (activeGame === 'cclimber') {
    if (k === 'w') { climberStep('left', 'up'); e.preventDefault(); return; }
    else if (k === 's') { climberStep('left', 'down'); e.preventDefault(); return; }
    else if (e.key === 'ArrowUp') { climberStep('right', 'up'); e.preventDefault(); return; }
    else if (e.key === 'ArrowDown') { climberStep('right', 'down'); e.preventDefault(); return; }
    else if (k === 'a' || e.key === 'ArrowLeft') { climberState.col = Math.max(0, climberState.col - 1); e.preventDefault(); return; }
    else if (k === 'd' || e.key === 'ArrowRight') { climberState.col = Math.min(3, climberState.col + 1); e.preventDefault(); return; }
  }

  // Standard directional & action controls for all games
  if (e.key === 'ArrowUp' || k === 'w') { handleUnifiedAction('up', true); e.preventDefault(); }
  else if (e.key === 'ArrowDown' || k === 's') { handleUnifiedAction('down', true); e.preventDefault(); }
  else if (e.key === 'ArrowLeft' || k === 'a') { handleUnifiedAction('left', true); e.preventDefault(); }
  else if (e.key === 'ArrowRight' || k === 'd') { handleUnifiedAction('right', true); e.preventDefault(); }
  else if (k === '1' || k === 'c') { insertCoin(); e.preventDefault(); }
  else if (k === '5' || k === 'p') { start1P(); e.preventDefault(); }
  else if (e.key === ' ' || e.key === 'Enter') {
    if (currentMode === 'tracker') toggleTracker();
    else if (currentMode === 'demo') { if (demoPlayer.playing) pauseDemoSong(); else playDemoSong(); }
    else handleUnifiedAction('action', true);
    e.preventDefault();
  }
  else if (e.key === 'Backspace' || k === 'r') { isRewinding = true; setMode('rewind'); e.preventDefault(); }
  else if (e.key === 'Tab') {
    const idx = (MODES.indexOf(currentMode) + 1) % MODES.length;
    setMode(MODES[idx]);
    e.preventDefault();
  }
  else if (k === 'b') { const bg = document.getElementById('btnGlitch'); if (bg) bg.click(); }
  else if (k === 'k') { toggleScanlines(); }
  else if (k === 'z') { if (typeof toggleScreenZoom === 'function') toggleScreenZoom(); }
});

window.addEventListener('keyup', (e) => {
  const k = e.key.toLowerCase();
  delete arcadeKeysDown[k];
  delete arcadeKeysDown[e.key];

  const cL = document.getElementById('ctrlBtnLeft'); if (cL && (k === 'a' || e.key === 'ArrowLeft')) cL.classList.remove('pressed');
  const cR = document.getElementById('ctrlBtnRight'); if (cR && (k === 'd' || e.key === 'ArrowRight')) cR.classList.remove('pressed');
  const cU = document.getElementById('ctrlBtnUp'); if (cU && (k === 'w' || e.key === 'ArrowUp')) cU.classList.remove('pressed');
  const cD = document.getElementById('ctrlBtnDown'); if (cD && (k === 's' || e.key === 'ArrowDown')) cD.classList.remove('pressed');
  const cF = document.getElementById('ctrlBtnFire'); if (cF && (e.key === ' ' || e.key === 'Enter')) cF.classList.remove('pressed');
  const cC = document.getElementById('ctrlBtnCoin'); if (cC && (k === '1' || k === 'c')) cC.classList.remove('pressed');
  const cS = document.getElementById('ctrlBtnStart'); if (cS && (k === '5' || k === 'p')) cS.classList.remove('pressed');
  const cG = document.getElementById('ctrlBtnImmortal'); if (cG && (k === 'i' || k === 'g')) cG.classList.remove('pressed');
  const cLvl = document.getElementById('ctrlBtnLevelSkip'); if (cLvl && (k === 'l' || k === 'n')) cLvl.classList.remove('pressed');

  if (e.key === 'ArrowUp' || k === 'w') handleUnifiedAction('up', false);
  else if (e.key === 'ArrowDown' || k === 's') handleUnifiedAction('down', false);
  else if (e.key === 'ArrowLeft' || k === 'a') handleUnifiedAction('left', false);
  else if (e.key === 'ArrowRight' || k === 'd') handleUnifiedAction('right', false);
  else if (e.key === ' ' || e.key === 'Enter') handleUnifiedAction('action', false);
  else if (e.key === 'Backspace' || k === 'r') { isRewinding = false; setMode('arcade'); }
});

// -------------------------------------------------------------------------
// MAIN EMULATION FRAME LOOP (60 FPS)
// -------------------------------------------------------------------------
let animTick = 0;

function stepCpuFrame() {
  let cyc = 0;
  while (cyc < 51200) {
    cyc += cpu.run_instruction();
  }
  if (vblankEnabled) {
    cpu.interrupt(false, intVector);
  }
  animTick++;
}

function mainLoop() {
  if (splashState.active) {
    renderSplashScreen();
    if (crtScanlines) drawScanlines();
    requestAnimationFrame(mainLoop);
    return;
  }

  if (currentMode === 'tour') {
    renderTourDemo();
    if (crtScanlines) drawScanlines();
    requestAnimationFrame(mainLoop);
    return;
  }

  if (coinPulseFrames > 0) {
    coinPulseFrames--;
    keyCoin = (coinPulseFrames > 6);
  }
  if (startPulseFrames > 0) {
    startPulseFrames--;
    keyStart = (startPulseFrames > 6);
  }

  // During boot test (< frame 305), run CPU at 5x speed so game boots in < 0.6 seconds!
  if (animTick < 305) {
    for (let fast = 0; fast < 5 && animTick < 305; fast++) {
      stepCpuFrame();
    }
  } else {
    // Normal 60 Hz frame
    if (currentMode === 'arcade' || currentMode === 'glitch') {
      stepCpuFrame();

      // Save state to rewind ring buffer
      if (animTick % 2 === 0) {
        if (rewindBuffer.length >= 300) rewindBuffer.shift();
        rewindBuffer.push({
          ram: new Uint8Array(ram),
          spritePos: new Uint8Array(spritePos)
        });
      }
    } else if (isRewinding) {
      if (rewindBuffer.length > 0) {
        const snap = rewindBuffer.pop();
        ram.set(snap.ram);
        spritePos.set(snap.spritePos);
      }
    }
  }

  // Update HUD info
  const credits = ram[0x4e69 - 0x4000];
  document.getElementById('hudCredits').textContent = `CREDITS: ${credits}`;
  if (animTick < 305) {
    document.getElementById('hudStatus').className = 'hud-badge booting';
    document.getElementById('hudStatus').textContent = '● BOOTING TEST...';
  } else if (credits === 0) {
    document.getElementById('hudStatus').className = 'hud-badge attract';
    document.getElementById('hudStatus').textContent = '● ATTRACT (INSERT COIN)';
  } else {
    document.getElementById('hudStatus').className = 'hud-badge';
    document.getElementById('hudStatus').textContent = '● PLAYING: READY!';
  }

  // Render Display
  if (currentMode === 'arcade' || currentMode === 'rewind' || currentMode === 'glitch') {
    if (activeGame === 'cclimber') {
      renderCrazyClimber();
    } else {
      renderArcadeFrame();
    }
    if (currentMode === 'rewind') {
      ctx.fillStyle = '#ff3344';
      ctx.font = 'bold 12px monospace';
      ctx.fillText('◄◄ REWINDING (HOLD KEY)', 12, 22);
    }
  } else if (currentMode === 'demo') {
    // Dynamic Multi-Track VU Meter & Jukebox Visualizer
    buf32.fill(0xff0e1017);
    ctx.putImageData(imgData, 0, 0);

    const song = DEMO_SONGS[demoPlayer.currentSongIdx];
    ctx.fillStyle = '#f5a623';
    ctx.font = 'bold 13px monospace';
    ctx.fillText(song.title.toUpperCase(), 12, 24);

    ctx.fillStyle = '#888';
    ctx.font = '10px monospace';
    ctx.fillText(song.synth, 12, 40);

    // Step Progress Bar
    ctx.fillStyle = '#222632';
    ctx.fillRect(12, 48, 216, 6);
    ctx.fillStyle = '#2ecc71';
    ctx.fillRect(12, 48, (demoPlayer.step / 64) * 216, 6);

    // Draw up to 15 animated track VU meters!
    const numTrks = song.tracks.length;
    const barW = Math.max(8, Math.floor(216 / numTrks) - 4);
    for (let t = 0; t < numTrks; t++) {
      const x = 12 + t * (barW + 4);
      const level = demoPlayer.vuLevels[t] || 0;
      const h = Math.floor(level * 120);

      // Bar background
      ctx.fillStyle = '#1c202a';
      ctx.fillRect(x, 70, barW, 120);

      // Active fill (gradient colors)
      ctx.fillStyle = t < 3 ? '#f5a623' : (t < 9 ? '#00d2ff' : '#e74c3c');
      ctx.fillRect(x, 190 - h, barW, h);

      // Channel number
      ctx.fillStyle = '#666';
      ctx.font = '8px monospace';
      ctx.fillText(String(t + 1), x + 1, 204);
    }

    ctx.fillStyle = demoPlayer.playing ? '#2ecc71' : '#f5a623';
    ctx.font = 'bold 11px monospace';
    ctx.fillText(demoPlayer.playing ? `PLAYING (BPM ${song.bpm}) · STEP ${demoPlayer.step + 1}/64` : 'PAUSED · CLICK PLAY SONG', 12, 228);

  } else if (currentMode === 'soundboard') {
    buf32.fill(0xff141720);
    ctx.putImageData(imgData, 0, 0);
    ctx.fillStyle = '#f5a623';
    ctx.font = 'bold 13px monospace';
    ctx.fillText('27-KEY AUTHENTIC SFX BOARD', 12, 26);
    ctx.fillStyle = '#888';
    ctx.font = '10px monospace';
    ctx.fillText('TOUCH SILICONE KEYS FOR ARCADE SOUNDS', 12, 44);

    if (lastSfxName) {
      ctx.fillStyle = '#2ecc71';
      ctx.font = 'bold 16px monospace';
      ctx.fillText(`TRIGGERED: [ ${lastSfxName} ]`, 12, 100);
      
      // Draw decorative waveform flare
      ctx.strokeStyle = '#f5a623';
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (let i = 0; i < 216; i++) {
        const y = 140 + Math.sin(i * 0.15 + animTick * 0.2) * 25 * (Math.random() * 0.5 + 0.5);
        if (i === 0) ctx.moveTo(12 + i, y); else ctx.lineTo(12 + i, y);
      }
      ctx.stroke();
    }
  } else if (currentMode === 'tracker') {
    renderTrackerScreen();
  } else if (currentMode === 'vector') {
    buf32.fill(0xff080a0e);
    for (let t = 0; t < 360; t++) {
      const rad = t * Math.PI / 180;
      const x = Math.floor(120 + 80 * Math.sin(rad * 3 + animTick * 0.05));
      const y = Math.floor(120 + 80 * Math.cos(rad * 2 + animTick * 0.03));
      if (x >= 0 && x < 240 && y >= 0 && y < 240) buf32[y * 240 + x] = 0xff00ffcc;
    }
    ctx.putImageData(imgData, 0, 0);
    ctx.fillStyle = '#00ffcc';
    ctx.font = 'bold 12px monospace';
    ctx.fillText('XY LISSAJOUS VECTOR OSC', 12, 22);
  }

  requestAnimationFrame(mainLoop);
}

// Initialize Demo Songs UI
initDemoJukebox();

requestAnimationFrame(mainLoop);
</script>
</body>
</html>
