function midiToStr(note) {
  if (!note || note === 0) return '---';
  const names = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
  const name = names[note % 12];
  const oct = Math.floor(note / 12) - 1;
  return (name.length === 1 ? name + '-' : name) + oct;
}

function playTrackerVoice(engine, midiNote, vol, durSec, time) {
  if (!audioCtx || !midiNote || vol <= 0) return;
  const now = time || audioCtx.currentTime;
  const freq = 440 * Math.pow(2, (midiNote - 69) / 12);
  const gainNode = audioCtx.createGain();
  const normalizedVol = (vol / 15.0) * 0.38;

  const osc = audioCtx.createOscillator();
  if (engine === 'wsg') {
    osc.type = 'triangle';
  } else if (engine === 'ay8910') {
    osc.type = 'square';
  } else if (engine === 'pokey') {
    osc.type = 'sawtooth';
  } else {
    osc.type = 'square';
  }

  osc.frequency.setValueAtTime(freq, now);
  gainNode.gain.setValueAtTime(normalizedVol, now);
  gainNode.gain.exponentialRampToValueAtTime(0.001, now + durSec * 0.92);

  osc.connect(gainNode);
  gainNode.connect(filterNode);

  osc.start(now);
  osc.stop(now + durSec);
}

function playArcadeDrum(type, vol, time) {
  if (!audioCtx || !type || type === '---') return;
  const now = time || audioCtx.currentTime;
  const normVol = (vol / 15.0) * 0.55;

  if (type === 'KCK') {
    const osc = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    osc.frequency.setValueAtTime(160, now);
    osc.frequency.exponentialRampToValueAtTime(38, now + 0.12);
    g.gain.setValueAtTime(normVol, now);
    g.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
    osc.connect(g);
    g.connect(filterNode);
    osc.start(now);
    osc.stop(now + 0.15);
  } else if (type === 'SNR') {
    if (noiseBuffer) {
      const src = audioCtx.createBufferSource();
      src.buffer = noiseBuffer;
      const flt = audioCtx.createBiquadFilter();
      flt.type = 'bandpass';
      flt.frequency.setValueAtTime(1400, now);
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(normVol * 0.85, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
      src.connect(flt);
      flt.connect(g);
      g.connect(filterNode);
      src.start(now);
      src.stop(now + 0.17);
    }
    const osc = audioCtx.createOscillator();
    const tg = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(220, now);
    osc.frequency.exponentialRampToValueAtTime(80, now + 0.08);
    tg.gain.setValueAtTime(normVol * 0.5, now);
    tg.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
    osc.connect(tg);
    tg.connect(filterNode);
    osc.start(now);
    osc.stop(now + 0.1);
  } else if (type === 'HHT') {
    if (noiseBuffer) {
      const src = audioCtx.createBufferSource();
      src.buffer = noiseBuffer;
      const flt = audioCtx.createBiquadFilter();
      flt.type = 'highpass';
      flt.frequency.setValueAtTime(7500, now);
      const g = audioCtx.createGain();
      g.gain.setValueAtTime(normVol * 0.6, now);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.045);
      src.connect(flt);
      flt.connect(g);
      g.connect(filterNode);
      src.start(now);
      src.stop(now + 0.05);
    }
  } else if (type === 'ZAP') {
    const osc = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(1800, now);
    osc.frequency.exponentialRampToValueAtTime(120, now + 0.15);
    g.gain.setValueAtTime(normVol * 0.7, now);
    g.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
    osc.connect(g);
    g.connect(filterNode);
    osc.start(now);
    osc.stop(now + 0.16);
  }
}

function trackerStep() {
  if (!trackerEngine.playing) return;
  const pat = trackerEngine.patterns[trackerEngine.currentPatternIdx];
  const stepMs = (60000 / trackerEngine.bpm) / 4;
  const now = audioCtx ? audioCtx.currentTime : 0;

  const stepData = pat.steps[trackerEngine.step];
  if (stepData) {
    // CH1: WSG Bass
    if (stepData[0][0] > 0) {
      playTrackerVoice('wsg', stepData[0][0], stepData[0][1], stepMs / 1000, now);
      trackerEngine.vuLevels[0] = stepData[0][1] / 15.0;
    } else {
      trackerEngine.vuLevels[0] *= 0.6;
    }

    // CH2: AY Lead
    if (stepData[1][0] > 0) {
      playTrackerVoice('ay8910', stepData[1][0], stepData[1][1], stepMs / 1000, now);
      trackerEngine.vuLevels[1] = stepData[1][1] / 15.0;
    } else {
      trackerEngine.vuLevels[1] *= 0.6;
    }

    // CH3: POKEY Arp
    if (stepData[2][0] > 0) {
      playTrackerVoice('pokey', stepData[2][0], stepData[2][1], stepMs / 1000, now);
      trackerEngine.vuLevels[2] = stepData[2][1] / 15.0;
    } else {
      trackerEngine.vuLevels[2] *= 0.6;
    }

    // CH4: Drums
    if (stepData[3] && stepData[3] !== '---') {
      playArcadeDrum(stepData[3], 15, now);
      trackerEngine.vuLevels[3] = 1.0;
    } else {
      trackerEngine.vuLevels[3] *= 0.6;
    }
  }

  // Advance step
  trackerEngine.step = (trackerEngine.step + 1) % 16;
  trackerEngine.timer = setTimeout(trackerStep, stepMs);
}

function startTracker() {
  initAudio();
  if (trackerEngine.playing) return;
  trackerEngine.playing = true;
  trackerStep();
  const btn = document.getElementById('btnQuickPlay');
  if (btn) btn.innerHTML = 'STOP<small>SPACE</small>';
}

function stopTracker() {
  trackerEngine.playing = false;
  if (trackerEngine.timer) {
    clearTimeout(trackerEngine.timer);
    trackerEngine.timer = null;
  }
  trackerEngine.vuLevels = [0, 0, 0, 0];
  const btn = document.getElementById('btnQuickPlay');
  if (btn) btn.innerHTML = 'PLAY<small>SPACE</small>';
}

function toggleTracker() {
  if (trackerEngine.playing) stopTracker();
  else startTracker();
}

function cycleTrackerPattern() {
  trackerEngine.currentPatternIdx = (trackerEngine.currentPatternIdx + 1) % trackerEngine.patterns.length;
  trackerEngine.bpm = trackerEngine.patterns[trackerEngine.currentPatternIdx].bpm;
  trackerEngine.step = 0;
  const status = document.getElementById('engineStatus');
  if (status) status.innerHTML = `TRACKER: <b>${trackerEngine.patterns[trackerEngine.currentPatternIdx].name}</b> (${trackerEngine.bpm} BPM)`;
}

function renderTrackerScreen() {
  // Deep CRT Dark Background
  ctx.fillStyle = '#0a0d14';
  ctx.fillRect(0, 0, 240, 240);

  const pat = trackerEngine.patterns[trackerEngine.currentPatternIdx];

  // 1. Header Bar (Y: 0..26)
  ctx.fillStyle = '#121622';
  ctx.fillRect(0, 0, 240, 26);
  ctx.strokeStyle = '#253045';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(0, 26); ctx.lineTo(240, 26);
  ctx.stroke();

  // Mode title
  ctx.fillStyle = '#00ff66';
  ctx.font = 'bold 9px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('● TRACKER 16-STEP', 8, 11);

  // Status badge & BPM
  ctx.font = 'bold 8px monospace';
  if (trackerEngine.playing) {
    ctx.fillStyle = '#00ff88';
    ctx.fillText(`▶ RUN ${trackerEngine.bpm} BPM`, 130, 11);
  } else {
    ctx.fillStyle = '#f5a623';
    ctx.fillText(`■ STOP ${trackerEngine.bpm} BPM`, 130, 11);
  }

  // Pattern name
  ctx.fillStyle = '#8ea4b8';
  ctx.font = '7.5px monospace';
  ctx.fillText(`P${trackerEngine.currentPatternIdx + 1}: ${pat.name.slice(0, 18)}`, 8, 22);
  ctx.fillStyle = '#557788';
  ctx.textAlign = 'right';
  ctx.fillText(pat.chipType.slice(0, 14), 232, 22);

  // 2. Track Columns Header (Y: 28..38)
  ctx.textAlign = 'left';
  ctx.fillStyle = '#151b28';
  ctx.fillRect(0, 27, 240, 12);
  ctx.font = '7.5px monospace';
  ctx.fillStyle = '#556677';
  ctx.fillText('STP', 6, 36);
  ctx.fillStyle = '#f5a623';
  ctx.fillText('CH1:BAS', 36, 36);
  ctx.fillStyle = '#00e5ff';
  ctx.fillText('CH2:LED', 88, 36);
  ctx.fillStyle = '#a55eea';
  ctx.fillText('CH3:ARP', 140, 36);
  ctx.fillStyle = '#ff6b81';
  ctx.fillText('CH4:DRM', 192, 36);

  // 3. Step Matrix (Y: 40..184) - 9 visible rows centered on current step
  const curStep = trackerEngine.step;
  for (let r = -4; r <= 4; r++) {
    const sIdx = (curStep + r + 16) % 16;
    const y = 112 + r * 15;
    const isCurrent = (r === 0);
    const stepData = pat.steps[sIdx];

    if (isCurrent) {
      // High-visibility glowing neon playhead row bar
      ctx.fillStyle = 'rgba(0, 255, 102, 0.22)';
      ctx.fillRect(2, y - 10, 236, 14);
      ctx.strokeStyle = 'rgba(0, 255, 136, 0.7)';
      ctx.lineWidth = 1;
      ctx.strokeRect(2, y - 10, 236, 14);

      // Playhead arrow
      ctx.fillStyle = '#00ff88';
      ctx.font = 'bold 8px monospace';
      ctx.fillText('►', 4, y);
    }

    // Step index
    ctx.font = isCurrent ? 'bold 8px monospace' : '7.5px monospace';
    ctx.fillStyle = isCurrent ? '#00ff88' : (sIdx % 4 === 0 ? '#8fa5a0' : '#445566');
    ctx.fillText(String(sIdx).padStart(2, '0'), 14, y);

    // Channel 1: Bass
    const ch1 = stepData[0];
    ctx.fillStyle = isCurrent ? '#ffffff' : (ch1[0] > 0 ? '#f5a623' : '#334455');
    ctx.fillText(ch1[0] > 0 ? `${midiToStr(ch1[0])} ${String(ch1[1]).padStart(2,' ')}` : '--- --', 36, y);

    // Channel 2: Lead
    const ch2 = stepData[1];
    ctx.fillStyle = isCurrent ? '#ffffff' : (ch2[0] > 0 ? '#00e5ff' : '#334455');
    ctx.fillText(ch2[0] > 0 ? `${midiToStr(ch2[0])} ${String(ch2[1]).padStart(2,' ')}` : '--- --', 88, y);

    // Channel 3: Arp
    const ch3 = stepData[2];
    ctx.fillStyle = isCurrent ? '#ffffff' : (ch3[0] > 0 ? '#c780ff' : '#334455');
    ctx.fillText(ch3[0] > 0 ? `${midiToStr(ch3[0])} ${String(ch3[1]).padStart(2,' ')}` : '--- --', 140, y);

    // Channel 4: Drum
    const ch4 = stepData[3];
    ctx.fillStyle = isCurrent ? '#ffffff' : (ch4 !== '---' ? '#ff6b81' : '#334455');
    ctx.fillText(ch4, 192, y);
  }

  // 4. VU Peak Meters (Y: 184..208)
  ctx.fillStyle = '#10141e';
  ctx.fillRect(0, 185, 240, 24);
  ctx.strokeStyle = '#222d3e';
  ctx.strokeRect(0, 185, 240, 24);

  const vuCoords = [36, 88, 140, 192];
  const vuColors = ['#f5a623', '#00e5ff', '#a55eea', '#ff6b81'];
  for (let ch = 0; ch < 4; ch++) {
    const x = vuCoords[ch];
    const vu = trackerEngine.vuLevels[ch] || 0;
    const h = Math.round(vu * 18);

    ctx.fillStyle = '#1c2434';
    ctx.fillRect(x, 188, 38, 18);

    ctx.fillStyle = vuColors[ch];
    ctx.fillRect(x + 1, 206 - h, 36, h);

    trackerEngine.vuLevels[ch] *= 0.88;
  }

  // 5. 16-Step Chaser LED Pips (Y: 212..223)
  for (let s = 0; s < 16; s++) {
    const px = 12 + s * 14.2;
    const isLit = (s === curStep);
    ctx.beginPath();
    ctx.arc(px, 218, isLit ? 3.5 : 2, 0, Math.PI * 2);
    if (isLit) {
      ctx.fillStyle = '#00ff66';
      ctx.shadowColor = '#00ff66';
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.shadowBlur = 0;
    } else {
      ctx.fillStyle = s % 4 === 0 ? '#385544' : '#1c2822';
      ctx.fill();
    }
  }

  // 6. Footer Controls Hint (Y: 226..238)
  ctx.fillStyle = '#00ffcc';
  ctx.font = '7px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('[SPACE]=PLAY/STOP · [KEYS]=LIVE JAM · [K1-4]=DSP', 120, 235);
}


// -------------------------------------------------------------------------
// TILE & SPRITE GRAPHICS PIPELINE
// -------------------------------------------------------------------------
const tiles = new Uint8Array(256 * 64);
const sprites = new Uint8Array(64 * 256);

function decodeStrip(rom, romOff, out, outOff, bx, by, imgWidth) {
  const base = outOff + by * imgWidth + bx;
  for (let x = 0; x < 8; x++) {
    const strip = rom[romOff + x];
    for (let y = 0; y < 4; y++) {
      const idx = base + (3 - y) * imgWidth + (7 - x);
      out[idx] = (strip >> y) & 1;
      out[idx] |= ((strip >> (y + 4)) & 1) << 1;
    }
  }
}

for (let i = 0; i < 256; i++) {
  decodeStrip(tileRom, i * 16 + 0, tiles, i * 64, 0, 4, 8);
  decodeStrip(tileRom, i * 16 + 8, tiles, i * 64, 0, 0, 8);
}
for (let i = 0; i < 64; i++) {
  decodeStrip(spriteRom, i * 64 + 0, sprites, i * 256, 8, 12, 16);
  decodeStrip(spriteRom, i * 64 + 8, sprites, i * 256, 8, 0, 16);
  decodeStrip(spriteRom, i * 64 + 16, sprites, i * 256, 8, 4, 16);
  decodeStrip(spriteRom, i * 64 + 24, sprites, i * 256, 8, 8, 16);
  decodeStrip(spriteRom, i * 64 + 32, sprites, i * 256, 0, 12, 16);
  decodeStrip(spriteRom, i * 64 + 40, sprites, i * 256, 0, 0, 16);
  decodeStrip(spriteRom, i * 64 + 48, sprites, i * 256, 0, 4, 16);
  decodeStrip(spriteRom, i * 64 + 56, sprites, i * 256, 0, 8, 16);
}

const paletteColors = [];
for (let i = 0; i < 32; i++) {
  const d = colorRom[i];
  const r = ((d >> 0) & 1) * 0x21 + ((d >> 1) & 1) * 0x47 + ((d >> 2) & 1) * 0x97;
  const g = ((d >> 3) & 1) * 0x21 + ((d >> 4) & 1) * 0x47 + ((d >> 5) & 1) * 0x97;
  const b = ((d >> 6) & 1) * 0x51 + ((d >> 7) & 1) * 0xae;
  paletteColors[i] = [r, g, b];
}

const canvas = document.getElementById('tftCanvas');
const ctx = canvas.getContext('2d');
const imgData = ctx.createImageData(240, 240);
const buf32 = new Uint32Array(imgData.data.buffer);
const arcadeBuf = new Uint32Array(224 * 288);

function drawTile(tileNo, palNo, bx, by) {
  const palOff = (palNo & 0x3f) * 4;
  for (let i = 0; i < 64; i++) {
    const px = i % 8, py = (i / 8) | 0;
    const colIdx = tiles[tileNo * 64 + i];
    const colVal = paletteRom[palOff + colIdx] & 0x1f;
    const [r, g, b] = paletteColors[colVal];
    const x = bx + px, y = by + py;
    if (x >= 0 && x < 224 && y >= 0 && y < 288) {
      arcadeBuf[y * 224 + x] = 0xff000000 | (b << 16) | (g << 8) | r;
    }
  }
}

function drawSprite(spriteNo, palNo, sx, sy, flipX, flipY) {
  const palOff = (palNo & 0x3f) * 4;
  for (let i = 0; i < 256; i++) {
    const sprX = i % 16, sprY = (i / 16) | 0;
    const px = flipX ? (15 - sprX) : sprX;
    const py = flipY ? (15 - sprY) : sprY;
    const colIdx = sprites[spriteNo * 256 + py * 16 + px];
    if (colIdx === 0) continue;
    const colVal = paletteRom[palOff + colIdx] & 0x1f;
    const [r, g, b] = paletteColors[colVal];
    const x = sx + sprX, y = sy + sprY;
    if (x >= 0 && x < 224 && y >= 0 && y < 288) {
      arcadeBuf[y * 224 + x] = 0xff000000 | (b << 16) | (g << 8) | r;
    }
  }
}

let crtScanlines = true;
function drawScanlines() {
  if (!crtScanlines) return;
  ctx.fillStyle = 'rgba(0, 0, 0, 0.28)';
  for (let y = 1; y < 240; y += 2) {
    ctx.fillRect(0, y, 240, 1);
  }
}

function renderArcadeFrame() {
  arcadeBuf.fill(0xff000000);
  
  // Tiles: Bottom 2 rows
  for (let i = 0x00; i <= 0x03f; i++) {
    drawTile(ram[i], ram[i + 0x400], (29 - (i % 0x20)) * 8, (i >= 0x20 ? 35 : 34) * 8);
  }
  // Tiles: Middle section
  for (let i = 0x40; i <= 0x3bf; i++) {
    drawTile(ram[i], ram[i + 0x400], (29 - Math.floor(i / 0x20)) * 8, (2 + (i % 0x20)) * 8);
  }
  // Tiles: Top 2 rows
  for (let i = 0x3c0; i <= 0x3ff; i++) {
    drawTile(ram[i], ram[i + 0x400], (29 - (i % 0x20)) * 8, (i >= 0x3e0 ? 1 : 0) * 8);
  }

  // 8 Hardware Sprites
  for (let s = 7; s >= 0; s--) {
    const sx = 239 - spritePos[s * 2];
    const sy = 272 - spritePos[s * 2 + 1];
    const info = ram[0x0ff0 + s * 2];
    const pal = ram[0x0ff0 + s * 2 + 1];
    drawSprite(info >> 2, pal, sx, sy, (info >> 1) & 1, info & 1);
  }

  // 5:6 Downsampling (288 -> 240) + Scanline Filter
  buf32.fill(0xff08090c);
  for (let outY = 0; outY < 240; outY++) {
    const inY = Math.floor(outY * 6 / 5);
    const inRow = inY * 224;
    const outRow = outY * 240 + 8;
    const scanDim = (crtScanlines && (outY % 2 === 1)) ? 0.72 : 1.0;
    
    for (let outX = 0; outX < 224; outX++) {
      const pix = arcadeBuf[inRow + outX];
      if (scanDim < 1.0) {
        const r = Math.floor((pix & 0xff) * scanDim);
        const g = Math.floor(((pix >> 8) & 0xff) * scanDim);
        const b = Math.floor(((pix >> 16) & 0xff) * scanDim);
        buf32[outRow + outX] = 0xff000000 | (b << 16) | (g << 8) | r;
      } else {
        buf32[outRow + outX] = pix;
      }
    }
  }

  ctx.putImageData(imgData, 0, 0);
}

// -------------------------------------------------------------------------
// STACK TRACE PRESENTS: ARCADE RAT v1.0 - ANIMATED STARTUP SPLASH SCREEN
// -------------------------------------------------------------------------
const splashState = {
  active: true,
  frame: 0,
  maxFrames: 240,
  chimePlayed: false,
  stars: Array.from({length: 28}, () => ({
    x: Math.random() * 240,
    y: Math.random() * 240,
    spd: 0.4 + Math.random() * 1.6,
    size: Math.random() > 0.75 ? 2 : 1
  }))
};

const stackTraceAvatarImg = new Image();
stackTraceAvatarImg.src = "data:image/png;base64,__STACK_TRACE_AVATAR_B64__";
let avatarLoaded = false;
stackTraceAvatarImg.onload = () => { avatarLoaded = true; };

function triggerSplashScreen() {
  initAudio();
  splashState.active = true;
  splashState.frame = 0;
  splashState.chimePlayed = false;
  setMode('arcade');
  playStartupChime();
}

function skipSplashScreen() {
  if (splashState.active) {
    splashState.active = false;
    initAudio();
  }
}

function renderSplashScreen() {
  splashState.frame++;
  const f = splashState.frame;

  if (f === 2 && !splashState.chimePlayed) {
    splashState.chimePlayed = true;
    playStartupChime();
  }

  // Update HUD status banner
  const hud = document.getElementById('hudStatus');
  if (hud) {
    hud.className = 'hud-badge booting';
    hud.textContent = '● STACK TRACE SPLASH';
  }

  // 1. Deep retro CRT dark background
  ctx.fillStyle = '#060a08';
  ctx.fillRect(0, 0, 240, 240);

  // 2. Animated floating cyber stars
  ctx.fillStyle = '#00ff66';
  for (let s of splashState.stars) {
    s.y += s.spd;
    if (s.y > 240) { s.y = 0; s.x = Math.random() * 240; }
    ctx.fillRect(Math.floor(s.x), Math.floor(s.y), s.size, s.size);
  }

  // Stage 1: CRT Electron Beam Ignition (Frames 0 - 25)
  if (f < 25) {
    const beamW = Math.min(240, f * 12);
    const beamH = Math.max(2, 24 - f);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(120 - beamW / 2, 120 - beamH / 2, beamW, beamH);
    ctx.fillStyle = 'rgba(0, 255, 102, 0.4)';
    ctx.fillRect(120 - beamW / 2, 110, beamW, 20);
    return;
  }

  // Stage 2: Avatar Reveal (Frames 25+)
  const cx = 120, cy = 76;
  const avatarR = 34;

  // Draw Stack Trace Avatar - cleanly framed, NO border or artificial rings
  ctx.save();
  ctx.beginPath();
  ctx.arc(cx, cy, avatarR, 0, Math.PI * 2);
  ctx.closePath();
  ctx.clip();
  if (avatarLoaded) {
    ctx.drawImage(stackTraceAvatarImg, cx - avatarR, cy - avatarR, avatarR * 2, avatarR * 2);
  } else {
    ctx.fillStyle = '#0f2415';
    ctx.fillRect(cx - avatarR, cy - avatarR, avatarR * 2, avatarR * 2);
    ctx.fillStyle = '#00ff66';
    ctx.font = 'bold 20px monospace';
    ctx.textAlign = 'center';
    ctx.fillText('ST', cx, cy + 7);
  }
  ctx.restore();

  // Stage 3: Typography Stagger & Branding Reveal
  ctx.textAlign = 'center';

  if (f >= 45) {
    // STACK TRACE
    ctx.save();
    ctx.font = 'bold 12px monospace';
    ctx.fillStyle = '#00ff66';
    ctx.shadowColor = '#00ff66';
    ctx.shadowBlur = 8;
    ctx.fillText('STACK TRACE', cx, 132);
    ctx.restore();
  }

  if (f >= 70) {
    // PRESENTS
    ctx.font = '800 8px monospace';
    ctx.fillStyle = '#a0ffc8';
    ctx.fillText('— PRESENTS —', cx, 146);
  }

  if (f >= 95) {
    // ARCADE RAT
    ctx.save();
    ctx.font = '900 20px -apple-system, monospace';
    ctx.fillStyle = '#f5a623';
    ctx.shadowColor = '#ff6600';
    ctx.shadowBlur = 12;
    ctx.fillText('ARCADE RAT', cx, 172);
    ctx.restore();

    // v 1.0 Badge
    ctx.fillStyle = '#e74c3c';
    ctx.fillRect(cx - 24, 180, 48, 14);
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 9px monospace';
    ctx.fillText('v 1.0', cx, 191);
  }

  // Stage 4: System Diagnostic Readouts (Frames 125+)
  if (f >= 125) {
    ctx.font = '8px monospace';
    ctx.textAlign = 'left';

    const diag = [
      '[OK] Z80 CORE @ 3.072MHz',
      '[OK] 4-CHIP SYNTH STACK',
      '[OK] 12-GAME FLASH VAULT',
      '>> PRESS ANY KEY TO PLAY <<'
    ];
    const linesToShow = Math.min(4, Math.floor((f - 125) / 18) + 1);
    for (let i = 0; i < linesToShow; i++) {
      if (i === 3) {
        if (Math.floor(f / 15) % 2 === 0) {
          ctx.fillStyle = '#f5a623';
          ctx.fillText(diag[i], 36, 208 + i * 10);
        }
      } else {
        ctx.fillStyle = '#00ff88';
        ctx.fillText(diag[i], 36, 208 + i * 10);
      }
    }
  }

  // Stage 5: Transition to Game (Frame 240+)
  if (f >= splashState.maxFrames) {
    splashState.active = false;
    currentMode = 'arcade';
  }
}

// -------------------------------------------------------------------------
// ACTIVE ARCADE GAME & CRAZY CLIMBER ENGINE
// -------------------------------------------------------------------------
let activeGame = 'pacman';

const climberState = {
  floor: 42,
  leftArm: 'up',   // 'up' | 'down'
  rightArm: 'down', // 'up' | 'down'
  col: 1,          // 0, 1, 2, 3
  potY: -20,
  potCol: 2,
  kongY: 50,
  score: 14850,
  animTick: 0
};

function switchActiveGame(gameId) {
  activeGame = gameId;
  document.getElementById('btnGamePacman').classList.toggle('active', gameId === 'pacman');
  document.getElementById('btnGameClimber').classList.toggle('active', gameId === 'cclimber');
  
  if (gameId === 'cclimber') {
    document.getElementById('engineStatus').innerHTML = 'CRAZY CLIMBER: <b>1980 NICHIBUTSU Z80 + AY-3-8910</b> (Twin-Stick)';
    document.getElementById('hudStatus').className = 'hud-badge';
    document.getElementById('hudStatus').textContent = '● CRAZY CLIMBER (TWIN-STICK)';
    const hint = document.getElementById('controlsHint');
    if (hint) hint.innerHTML = 'Twin-Stick: <b>W/S</b> (Left Arm) · <b>▲/▼</b> (Right Arm) · <b>A/D</b> (Col) · or Tap Screen Quadrants';
    playArcadeSfx('WARP');
  } else {
    document.getElementById('engineStatus').textContent = 'PAC-MAN (60 FPS Z80 + WSG)';
    document.getElementById('hudStatus').className = 'hud-badge';
    document.getElementById('hudStatus').textContent = '● PAC-MAN ACTIVE';
    const hint = document.getElementById('controlsHint');
    if (hint) hint.innerHTML = 'Controls: <b>WASD</b> or <b>Arrow Keys</b> or <b>On-Screen D-Pad</b>';
  }
}

function renderCrazyClimber() {
  climberState.animTick++;
  
  // Sky background
  buf32.fill(0xff06070a);
  
  // Skyscraper dimensions (x: 24 to 216, y: 0 to 240)
  for (let y = 0; y < 240; y++) {
    for (let x = 24; x < 216; x++) {
      // Brick pattern
      const isMortar = (y % 16 === 0) || ((x + ((y / 16) | 0) * 8) % 24 === 0);
      buf32[y * 240 + x] = isMortar ? 0xff2a1b12 : 0xff66361a;
    }
  }

  // 4 Columns of Windows
  const windowCols = [44, 84, 124, 164];
  for (let row = 0; row < 6; row++) {
    const wy = (row * 40 + (climberState.floor % 40)) % 240;
    for (let c = 0; c < 4; c++) {
      const wx = windowCols[c];
      const isOpen = (row + c + (climberState.animTick >> 6)) % 3 === 0;
      
      // Window frame
      for (let py = 0; py < 24; py++) {
        for (let px = 0; px < 24; px++) {
          const sy = (wy + py) % 240;
          const sx = wx + px;
          const isBorder = px === 0 || px === 23 || py === 0 || py === 23;
          const col = isBorder ? 0xffdcdde1 : (isOpen ? 0xff000000 : 0xff1b76bc);
          buf32[sy * 240 + sx] = col;
        }
      }
    }
  }

  // Falling flower pot
  climberState.potY += 2;
  if (climberState.potY > 240) {
    climberState.potY = -15;
    climberState.potCol = Math.floor(Math.random() * 4);
  }
  const potX = windowCols[climberState.potCol] + 6;
  const potY = Math.floor(climberState.potY);
  if (potY >= 0 && potY < 230) {
    for (let py = 0; py < 10; py++) {
      for (let px = 0; px < 12; px++) {
        buf32[(potY + py) * 240 + (potX + px)] = 0xff27ae60; // green flower pot
      }
    }
  }

  // King Kong on the side ledge
  const kongX = 4;
  const kongY = 70 + Math.sin(climberState.animTick * 0.08) * 15;
  for (let py = 0; py < 30; py++) {
    for (let px = 0; px < 18; px++) {
      const ky = Math.floor(kongY + py);
      if (ky >= 0 && ky < 240) {
        buf32[ky * 240 + (kongX + px)] = 0xff1e272e;
      }
    }
  }

  // Climber character at active column
  const cx = windowCols[climberState.col] + 2;
  const cy = 135;
  for (let py = 0; py < 26; py++) {
    for (let px = 0; px < 20; px++) {
      let col = 0;
      if (py < 6) col = 0xfff1c40f; // Yellow hardhat
      else if (py < 12) col = 0xfff5cd79; // Face
      else if (py < 20) col = 0xffe74c3c; // Red shirt
      else col = 0xff2980b9; // Blue trousers
      buf32[(cy + py) * 240 + (cx + px)] = col;
    }
  }

  // Left & Right Arms gripping windows
  const leftArmUp = climberState.leftArm === 'up';
  const rightArmUp = climberState.rightArm === 'up';
  for (let a = 0; a < 8; a++) {
    const lay = leftArmUp ? (cy - 6 + a) : (cy + 10 + a);
    buf32[lay * 240 + (cx - 3)] = 0xfff5cd79;
    const ray = rightArmUp ? (cy - 6 + a) : (cy + 10 + a);
    buf32[ray * 240 + (cx + 21)] = 0xfff5cd79;
  }

  // Scanline overlay
  if (crtScanlines) {
    for (let y = 1; y < 240; y += 2) {
      for (let x = 0; x < 240; x++) {
        const pix = buf32[y * 240 + x];
        const r = ((pix & 0xff) * 0.75) | 0;
        const g = (((pix >> 8) & 0xff) * 0.75) | 0;
        const b = (((pix >> 16) & 0xff) * 0.75) | 0;
        buf32[y * 240 + x] = 0xff000000 | (b << 16) | (g << 8) | r;
      }
    }
  }

  ctx.putImageData(imgData, 0, 0);

  // Crazy Climber HUD
  ctx.fillStyle = '#f5a623';
  ctx.font = 'bold 11px monospace';
  ctx.fillText(`1UP: ${climberState.score}`, 12, 16);
  ctx.fillStyle = '#2ecc71';
  ctx.fillText(`FLOOR: ${climberState.floor}F/200F`, 128, 16);

  ctx.fillStyle = '#ffffff';
  ctx.font = '9px monospace';
  ctx.fillText(`TWIN-STICK: L[${climberState.leftArm.toUpperCase()}] R[${climberState.rightArm.toUpperCase()}]`, 12, 232);
}

